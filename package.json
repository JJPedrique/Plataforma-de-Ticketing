{
  "name": "root-workspace",
  "version": "1.0.0",
  "scripts": {
    "install:client": "npm install --prefix client",
    "install:server": "cd server && .\\venv\\Scripts\\python -m pip install -r requirements.txt",
    "install": "concurrently \"npm run install:client\" \"npm run install:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "cd server && .\\venv\\Scripts\\uvicorn main:app --reload",
    "dev": "concurrently -k -c \"cyan,magenta\" -n \"CLIENTE,SERVIDOR\" \"npm run dev:client\" \"npm run dev:server\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}